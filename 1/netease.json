{
  "capabilities" : [
    "metadata",
    "cover",
    "dynamicCover",
    "lyrics",
    "lyricsWordLevel"
  ],
  "color" : "#E60026",
  "cover" : {
    "method" : "GET",
    "rule" : {
      "format" : "albumCatalogCover"
    },
    "url" : "https:\/\/music.163.com\/api\/song\/detail?ids=[{{id}}]&id={{id}}"
  },
  "detail" : {
    "method" : "GET",
    "rule" : {
      "format" : "albumCatalogDetail"
    },
    "url" : "https:\/\/music.163.com\/api\/song\/detail?ids=[{{id}}]&id={{id}}"
  },
  "dynamicCover" : {
    "assetHosts" : [
      "*.music.126.net",
      "*.music.163.com",
      "*.vod.126.net"
    ],
    "bodyTemplate" : "{\"songId\":\"{{id}}\"}",
    "crypto" : {
      "algorithm" : "aes-128-ecb",
      "digest" : "md5",
      "keySecret" : "eapiKey",
      "messageTemplate" : "nobody{{path}}use{{text}}md5forencrypt",
      "padding" : "pkcs7",
      "path" : "\/api\/songplay\/dynamic-cover",
      "plainTemplate" : "{{path}}-{{eapiSeparator}}-{{text}}-{{eapiSeparator}}-{{digest}}",
      "requestEncoding" : "hex-upper",
      "requestField" : "params",
      "responseCompression" : "gzip-optional",
      "responseEncoding" : "json-or-hex",
      "separatorSecret" : "eapiSeparator",
      "type" : "netease-eapi"
    },
    "headers" : {
      "Content-Type" : "application\/x-www-form-urlencoded"
    },
    "method" : "POST",
    "optional" : true,
    "rule" : {
      "format" : "albumCatalogMotionArtwork"
    },
    "url" : "https:\/\/interface.music.163.com\/eapi\/songplay\/dynamic-cover"
  },
  "headers" : {
    "Origin" : "https:\/\/music.163.com",
    "Referer" : "https:\/\/music.163.com\/",
    "User-Agent" : "Mozilla\/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit\/537.36 (KHTML, like Gecko) Chrome\/120.0.0.0 Safari\/537.36"
  },
  "icon" : "cloud",
  "id" : "netease",
  "lyrics" : {
    "method" : "GET",
    "rule" : {
      "format" : "albumCatalogLyrics"
    },
    "url" : "https:\/\/music.163.com\/api\/song\/lyric?id={{id}}&lv=1&yv=1"
  },
  "name" : "网易云音乐",
  "rateLimit" : 1000,
  "search" : {
    "method" : "GET",
    "params" : {
      "limit" : "{{limit}}",
      "offset" : "0",
      "s" : "{{query}}",
      "type" : "1"
    },
    "rule" : {
      "format" : "albumCatalogSearch"
    },
    "url" : "https:\/\/music.163.com\/api\/search\/get"
  },
  "version" : 12
}