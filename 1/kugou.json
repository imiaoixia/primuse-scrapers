{
  "capabilities" : [
    "metadata",
    "cover",
    "dynamicCover",
    "lyrics",
    "lyricsWordLevel"
  ],
  "color" : "#2196F3",
  "cover" : {
    "method" : "LOCAL",
    "params" : {
      "keyword" : "{{id}}",
      "page" : "1",
      "pagesize" : "1",
      "showtype" : "1"
    },
    "rule" : {
      "format" : "hashCatalogCover"
    },
    "url" : "http:\/\/mobilecdn.kugou.com\/api\/v3\/search\/song"
  },
  "detail" : {
    "method" : "LOCAL",
    "params" : {
      "keyword" : "{{id}}",
      "page" : "1",
      "pagesize" : "1",
      "showtype" : "1"
    },
    "rule" : {
      "format" : "hashCatalogDetail"
    },
    "url" : "http:\/\/mobilecdn.kugou.com\/api\/v3\/search\/song"
  },
  "dynamicCover" : {
    "assetHosts" : [
      "*.kugou.com",
      "*.kugou.cn",
      "*.myqcloud.com",
      "kgv.stream.tencentmusic.com"
    ],
    "headers" : {
      "dfid" : "-"
    },
    "method" : "GET",
    "optional" : true,
    "params" : {
      "appid" : "1005",
      "clientver" : "20489",
      "data" : "[{\"album_audio_id\":{{id[6]}},\"album_id\":{{id[1]}}}]",
      "isCdn" : "1",
      "query" : "audioPlay"
    },
    "requiredIdSegments" : [
      6
    ],
    "rule" : {
      "format" : "hashCatalogMotionArtwork"
    },
    "sign" : {
      "clientTimeHeader" : "clienttime",
      "deviceIDSecret" : "requestDeviceID",
      "param" : "signature",
      "saltSecret" : "requestSalt",
      "type" : "md5-wrap"
    },
    "url" : "https:\/\/kmrcdn.service.kugou.com\/v2\/album\/audio"
  },
  "headers" : {
    "Referer" : "https:\/\/www.kugou.com\/",
    "User-Agent" : "Mozilla\/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit\/537.36"
  },
  "icon" : "waveform",
  "id" : "kugou",
  "lyrics" : {
    "method" : "GET",
    "params" : {
      "appid" : "3116",
      "client" : "mobi",
      "clientver" : "11070",
      "duration" : "{{id[4]}}000",
      "hash" : "{{id[0]}}",
      "keyword" : "{{id[3]}} - {{id[2]}}",
      "man" : "no",
      "ver" : "1"
    },
    "rule" : {
      "format" : "hashCatalogLyrics"
    },
    "url" : "https:\/\/krcs.kugou.com\/search"
  },
  "lyricsFallback" : {
    "contentField" : "content",
    "encoding" : "base64UTF8",
    "requiredVariables" : [
      "lyricId",
      "accessKey"
    ],
    "url" : "https:\/\/lyrics.kugou.com\/download?ver=1&client=pc&id={{lyricId}}&accesskey={{accessKey}}&fmt=lrc&charset=utf8"
  },
  "name" : "酷狗音乐",
  "rateLimit" : 300,
  "search" : {
    "method" : "GET",
    "params" : {
      "keyword" : "{{query}}",
      "page" : "1",
      "pagesize" : "{{limit}}",
      "showtype" : "1"
    },
    "rule" : {
      "format" : "hashCatalogSearch"
    },
    "url" : "http:\/\/mobilecdn.kugou.com\/api\/v3\/search\/song"
  },
  "sslTrustDomains" : [
    "kugou.com",
    "mobilecdn.kugou.com",
    "imge.kugou.com",
    "krcs.kugou.com",
    "myqcloud.com"
  ],
  "version" : 12
}